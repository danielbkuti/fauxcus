DEBUG=True
SECRET_KEY=your-secret-key
ALLOWED_HOSTS=localhost
# The deployed frontend's real origin (e.g. https://fauxcus.vercel.app) —
# also trusted for CORS/CSRF automatically, on top of localhost:3000.
FRONTEND_URL=http://localhost:3000
# Optional, comma-separated: any other origins that need CORS/CSRF trust
# (a custom domain, a host's per-branch preview URLs, etc).
ADDITIONAL_TRUSTED_ORIGINS=
POSTGRES_DB=postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=db
POSTGRES_PORT=5432
EMAIL_HOST_USER=your-email
EMAIL_HOST_PASSWORD=your-password