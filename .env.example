DEBUG=True
SECRET_KEY=your-secret-key
ALLOWED_HOSTS=localhost
# Only needed if the frontend is ever split back out to its own origin
# (it isn't in production — see render.yaml's note on why) or hosted
# somewhere FRONTEND_URL can't self-derive from RENDER_EXTERNAL_HOSTNAME.
# Trusted for CORS/CSRF automatically, on top of localhost:3000.
FRONTEND_URL=http://localhost:3000
# Optional, comma-separated: any other origins that need CORS/CSRF trust
# (a custom domain, a host's per-branch preview URLs, etc).
ADDITIONAL_TRUSTED_ORIGINS=
# Local dev (docker-compose) uses the five discrete POSTGRES_* vars
# below. A host that hands over one connection string instead (Render,
# Railway, ...) can set DATABASE_URL — postgresql://user:pass@host:port/db
# — instead, which takes priority over the five when present.
DATABASE_URL=
POSTGRES_DB=postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=db
POSTGRES_PORT=5432
EMAIL_HOST_USER=your-email
EMAIL_HOST_PASSWORD=your-password
# Shared secret for POST /api/internal/send-deadline-digest/ (see
# tasks.api.views.TriggerDeadlineDigestView and
# .github/workflows/deadline-digest-cron.yml). Leave blank locally —
# the endpoint refuses to run with no token configured. Only needed in
# an environment a GitHub Actions cron actually calls (production).
DIGEST_CRON_TOKEN=
# Celery's broker (see backend/flexmaster/celery.py) — local dev only,
# never used in production (Render has nowhere to run Celery/Redis at
# all; see render.yaml's own notes). "redis" here is docker-compose.yml's
# redis service hostname, so this default is right for docker-compose
# as-is; override only for a non-docker-compose local setup.
CELERY_BROKER_URL=redis://redis:6379/0